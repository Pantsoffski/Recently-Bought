#. Plugin Name of the plugin
#: pp-recently-bought-for-woocommerce.php
msgid "Recently Bought This for WooCommerce"
msgstr "Recently Bought This for WooCommerce"

#. Plugin URI of the plugin
#: pp-recently-bought-for-woocommerce.php
msgid "https://wordpress.org/plugins/recently-bought-this-for-woocommerce/"
msgstr "https://wordpress.org/plugins/recently-bought-this-for-woocommerce/"

#. Description of the plugin
#: pp-recently-bought-for-woocommerce.php
msgid "Show linked product notifications for confirmed WooCommerce orders without revealing buyer details."
msgstr ""
"Wyświetlaj powiadomienia o potwierdzonych zamówieniach WooCommerce z linkami"
" do produktów, bez ujawniania danych kupujących."

#. Author of the plugin
#: pp-recently-bought-for-woocommerce.php
msgid "Piotr Pesta"
msgstr "Piotr Pesta"

#. Author URI of the plugin
#: pp-recently-bought-for-woocommerce.php
msgid "https://profiles.wordpress.org/piotr-pesta/"
msgstr "https://profiles.wordpress.org/piotr-pesta/"

#: classes.php:108
msgid "Ordered today"
msgstr "Zamówiono dzisiaj"

#: classes.php:109
msgid "Ordered yesterday"
msgstr "Zamówiono wczoraj"

#: classes.php:110
msgid "Ordered within the last 7 days"
msgstr "Zamówiono w ostatnich 7 dniach"

#: classes.php:111
msgid "Ordered within the last 30 days"
msgstr "Zamówiono w ostatnich 30 dniach"

#: classes.php:112
msgid "Purchased in this store"
msgstr "Kupiono w tym sklepie"

#: classes.php:167
msgid "Recently Bought"
msgstr "Ostatnie zakupy"

#: classes.php:193
msgid "Settings"
msgstr "Ustawienia"

#: classes.php:203
msgid "Recently Bought This for WooCommerce requires WooCommerce 11.2 or newer."
msgstr ""
"Recently Bought This for WooCommerce wymaga WooCommerce 11.2 lub nowszego."

#: classes.php:204
msgid "Recently Bought This for WooCommerce requires WooCommerce to be installed and active."
msgstr ""
"Recently Bought This for WooCommerce wymaga zainstalowanej i aktywnej "
"wtyczki WooCommerce."

#: classes.php:245
msgid "Close notification"
msgstr "Zamknij powiadomienie"

#: classes.php:268
msgid "Recent purchases"
msgstr "Ostatnie zakupy"

#: classes.php:302
msgid "Someone recently bought"
msgstr "Ktoś niedawno kupił"

#: views/options.php:17
msgid "Recently Bought This for WooCommerce - Settings"
msgstr "Recently Bought This for WooCommerce – ustawienia"

#: views/options.php:25
msgid "Text to show:"
msgstr "Wyświetlany tekst:"

#: views/options.php:28
msgid "Enter the complete message as plain text. The default “recently bought” displays as “Someone recently bought”. Leaving the field empty uses the neutral purchase message below."
msgstr "Wpisz cały komunikat jako zwykły tekst. Domyślna wartość „recently bought” wyświetla się jako „Ktoś niedawno kupił”. Puste pole używa ustawionego poniżej neutralnego komunikatu o zakupie."

#: views/options.php:33
msgid "Notification texts"
msgstr "Teksty powiadomień"

#: views/options.php:34
msgid "Leave blank to use the WordPress translation."
msgstr "Pozostaw puste, aby użyć tłumaczenia WordPressa."

#: views/options.php:48
msgid "Number of orders to show (2-10):"
msgstr "Liczba wyświetlanych zamówień (2–10):"

#: views/options.php:52
msgid "In which shop corner you wish to show it?"
msgstr "W którym narożniku wyświetlać powiadomienia?"

#: views/options.php:55
msgid "Right-Top"
msgstr "Prawy górny"

#: views/options.php:56
msgid "Right-Bottom"
msgstr "Prawy dolny"

#: views/options.php:57
msgid "Left-Bottom"
msgstr "Lewy dolny"

#: views/options.php:58
msgid "Left-Top"
msgstr "Lewy górny"

#: views/options.php:63
msgid "Bottom spacing"
msgstr "Dolny odstęp"

#: views/options.php:66
msgid "Applies to the bottom corners."
msgstr "Dotyczy dolnych narożników."

#: views/options.php:67
msgid "Automatic (recommended)"
msgstr "Automatyczny (zalecany)"

#: views/options.php:68
msgid "Automatically avoid bottom navigation bars."
msgstr "Automatycznie omijaj dolne paski nawigacji."

#: views/options.php:69
msgid "Standard"
msgstr "Standardowy"

#: views/options.php:70
msgid "Use the normal corner position without additional spacing."
msgstr "Użyj zwykłej pozycji w narożniku bez dodatkowego odstępu."

#: views/options.php:71
msgid "Manual"
msgstr "Ręczny"

#: views/options.php:72
msgid "Set an additional bottom offset for a theme or component that Automatic does not detect."
msgstr "Ustaw dodatkowy odstęp od dołu, jeśli tryb automatyczny nie wykrywa elementu motywu lub wtyczki."

#: views/options.php:73
msgid "Additional bottom spacing (px)"
msgstr "Dodatkowy dolny odstęp (px)"

#: views/options.php:79
msgid "Randomize orders:"
msgstr "Losowa kolejność zamówień:"

#: views/options.php:83
msgid "Popup after some delay (0-30 seconds):"
msgstr "Opóźnienie powiadomienia (0–30 sekund):"

#: views/options.php:87
msgid "Purchase time information"
msgstr "Informacja o czasie zakupu"

#: views/options.php:90
msgid "Do not display purchase time"
msgstr "Nie pokazuj czasu zakupu"

#: views/options.php:91
msgid "Display approximate purchase time"
msgstr "Pokazuj przybliżony czas zakupu"
